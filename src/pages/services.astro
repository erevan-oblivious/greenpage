---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import bannerImage from '../assets/banner.of.elements.png';
---

<BaseLayout title="Our Services | Green Page">

<h1 class="heading">Our Services</h1>
<div class="prose-container">
  <p>Discover our range of eco-friendly web development and optimization solutions.</p>
</div>
<div class="image-container">
  <Image 
    src={bannerImage} 
    alt="Banner Image"
    format="webp"
      quality={80}
    />
</div>
<p>See our eco-friendly web development projects in action.</p>
<div class="video-container">
  <video 
    autoplay 
    loop 
    muted 
    playsinline
    >
    <source src="https://media.greenpage.uk/Goodfellow%20Farming%20Harvesting%20Barley%20(480p).mp4" type="video/mp4"/>
    Your browser does not support HTML5 video tags.
  </video>
</div>

</BaseLayout>