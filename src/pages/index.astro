---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home | Green Page">

  <main class="content-container"> <!-- Main content container -->
    <h1 class="heading ">Welcome to GreenPage</h1>
    <p>Building clean, fast, eco-friendly web experiences.</p>
    <section class="cards-container"> <!-- Container for the cards -->
      <div class="card">
        <h2>Fast Performance</h2>
        <p>Lean, hand-crafted HTML and CSS ensure light-speed rendering.</p>
      </div>
      <div class="card">
        <h2>Eco-Friendly</h2>
        <p>Hosted on minimal infrastructure to reduce digital carbon footprint.</p>
      </div>
      <div class="card">
        <h2>Clean Structure</h2>
        <p>Semantic HTML markup built with modern accessibility standards.</p>
      </div>
    </section>
  </main> 

</BaseLayout>