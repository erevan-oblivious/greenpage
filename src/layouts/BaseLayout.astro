---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Green Page' } = Astro.props;
---

<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>

<body>

  <header class="header"> <!-- Header -->
      <a href="/" >Green Page</a>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
      </nav>
  </header>

  <main class="main"> <!-- Main content area -->
    <slot />
  </main>

  <footer class="footer"> <!-- Footer -->
    <p>&copy; {new Date().getFullYear()} Green Page. All rights reserved.</p>
  </footer>

</body>

</html>