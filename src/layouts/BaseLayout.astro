---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Green Page' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 min-h-screen flex flex-col font-sans antialiased text-slate-800">
    <!-- Header / Navigation -->
    <header class="bg-[#2b3529] py-4 px-8 text-white">
      <div class="max-w-4xl mx-auto flex justify-between items-center">
        <a href="/" class="font-bold text-xl hover:text-slate-900 transition-colors">Green Page</a>
        <nav class="space-x-6 text-sm font-medium">
          <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
          <a href="/services" class="hover:text-slate-900 transition-colors">Services</a>
        </nav>
      </div>
    </header>

    <!-- Page Content Slot -->
    <main class="flex-grow max-w-4xl w-full mx-auto p-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#2b3529] py-6 text-center text-sm text-white">
      <p>&copy; {new Date().getFullYear()} Green Page. All rights reserved.</p>
    </footer>
  </body>
</html>